{
  "name": "biblio",
  "version": "2.0.0",
  "private": true,
  "author": "Gentlemonke <gentlemonke@xinlabs.io>",
  "repository": "https://github.com/xin-dragons/biblio.tech",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @biblio/api --filter @biblio/web --parallel dev",
    "dev:web": "pnpm --filter @biblio/web dev",
    "dev:api": "pnpm --filter @biblio/api dev",
    "dev:legacy": "pnpm --filter @biblio/legacy dev",
    "build": "pnpm --filter @biblio/web build && pnpm --filter @biblio/api build",
    "build:web": "pnpm --filter @biblio/web build",
    "build:api": "pnpm --filter @biblio/api build",
    "deploy": "pnpm --filter @biblio/api deploy && pnpm --filter @biblio/web deploy",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
