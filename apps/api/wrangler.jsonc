{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biblio-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // Dev server configuration
  "dev": {
    "port": 8800,
  },

  // Durable Objects
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO",
      },
      {
        "name": "RATE_LIMITER_DO",
        "class_name": "RateLimiterDO",
      },
      {
        "name": "TENSOR_RATE_LIMITER_DO",
        "class_name": "TensorRateLimiterDO",
      },
      {
        "name": "USERNAMES_DO",
        "class_name": "UsernamesDO",
      },
      {
        "name": "VOTING_DO",
        "class_name": "VotingDO",
      },
      {
        "name": "RPC_WEBSOCKET_DO",
        "class_name": "RpcWebSocketDO",
      },
      {
        "name": "STAKER_SETTINGS_DO",
        "class_name": "StakerSettingsDO",
      },
      {
        "name": "NFT_CACHE_DO",
        "class_name": "NftCacheDO",
      },
      {
        "name": "STAKE_RECORDS_DO",
        "class_name": "StakeRecordsDO",
      },
    ],
  },

  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UserDO",
        "RateLimiterDO",
        "TensorRateLimiterDO",
        "UsernamesDO",
        "VotingDO",
        "RpcWebSocketDO",
        "StakerSettingsDO",
        "NftCacheDO",
        "StakeRecordsDO"
      ],
    },
  ],

  // D1 Database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblio-db",
      "database_id": "placeholder-will-be-set-after-creation",
    },
  ],

  // Environment variables (secrets set via wrangler secret)
  "vars": {
    "ENVIRONMENT": "development",
  },

  // Uncomment for production
  // "env": {
  //   "production": {
  //     "vars": {
  //       "ENVIRONMENT": "production"
  //     }
  //   }
  // }
}
